# Local development only. Replace every value before starting Compose.
POSTGRES_DB=haoblog_dev
POSTGRES_USER=haoblog_dev
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_PORT=5432

# API database connection; keep this value out of Git in real environments.
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/haoblog_dev
JDBC_DATABASE_USERNAME=haoblog_dev
JDBC_DATABASE_PASSWORD=replace-with-a-local-random-password

API_PORT=8080
WEB_PORT=3000

# Local bootstrap: provide a BCrypt hash, never a plaintext password.
HAOBLOG_ADMIN_USERNAME=admin
HAOBLOG_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
HAOBLOG_SESSION_COOKIE_SECURE=false
HAOBLOG_PUBLIC_BASE_URL=http://localhost:3000
HAOBLOG_AUTHOR_NAME=Hao

# OSS is disabled locally by default. These are server-only values; never put a real key in Git.
HAOBLOG_OSS_ENABLED=false
# HAOBLOG_OSS_BUCKET=haoblog-bucket
# HAOBLOG_OSS_REGION=cn-guangzhou
# HAOBLOG_OSS_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
# HAOBLOG_OSS_ACCESS_KEY_ID=replace-with-server-access-key-id
# HAOBLOG_OSS_ACCESS_KEY_SECRET=replace-with-server-access-key-secret
# HAOBLOG_OSS_PUBLIC_BASE_URL=https://img.haoblog.com.cn

# Production Compose only: inject these from an external env file.
# HAOBLOG_DOMAIN=example.invalid
# HAOBLOG_PUBLIC_BASE_URL=https://www.example.invalid
# HAOBLOG_AUTHOR_NAME=Hao
# HAOBLOG_API_IMAGE=registry.example.invalid/haoblog-api:git-sha
# HAOBLOG_WEB_IMAGE=registry.example.invalid/haoblog-web:git-sha
