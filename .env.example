# Local development only. Replace every value before starting Compose.
POSTGRES_DB=haoblog_dev
POSTGRES_USER=haoblog_dev
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_PORT=5432

# API database connection; keep this value out of Git in real environments.
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/haoblog_dev
JDBC_DATABASE_USERNAME=haoblog_dev
JDBC_DATABASE_PASSWORD=replace-with-a-local-random-password

API_PORT=8080
WEB_PORT=3000

# Production Compose only: inject these from an external env file.
# HAOBLOG_DOMAIN=example.invalid
# HAOBLOG_API_IMAGE=registry.example.invalid/haoblog-api:git-sha
# HAOBLOG_WEB_IMAGE=registry.example.invalid/haoblog-web:git-sha
