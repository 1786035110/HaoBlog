(web_failure) {
	route {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		header Retry-After 1
		header X-Robots-Tag "noindex, nofollow"
		header X-Request-ID {vars.haoblog_trace_id}
		respond <<HTML
<!doctype html><html lang="zh-CN" data-theme="night"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>观测站暂时失联 · HaoBlog</title><style>:root{color-scheme:dark;--bg:#06110f;--line:#1e3a33;--accent:#a8ff60;--text:#e8f1ee;--mute:#8db7ac}*{box-sizing:border-box}html{background:var(--bg);color:var(--text);font-family:"PingFang SC","HarmonyOS Sans",sans-serif}body{margin:0;border-top:1px solid var(--accent);min-height:100vh;display:grid;place-items:center;padding:24px}main{width:min(42rem,100%);border-left:1px solid var(--line);padding:clamp(20px,6vw,56px)}p{color:var(--mute);line-height:1.7}.label{font:12px/1.4 ui-monospace,monospace;letter-spacing:.12em;color:var(--accent)}h1{font-size:clamp(2rem,8vw,4.5rem);line-height:1;margin:.5rem 0 1rem}nav{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}button,a{min-height:44px;border:1px solid var(--accent);border-radius:0;background:transparent;color:var(--accent);padding:11px 14px;font:13px/1.4 ui-monospace,monospace;text-decoration:none;cursor:pointer}button:focus-visible,a:focus-visible{outline:2px solid var(--text);outline-offset:3px}@media(max-width:360px){nav,form{display:grid;width:100%}button,a{text-align:center;width:100%}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}</style></head><body><main><p class="label">SIGNAL / 503</p><h1>观测站暂时失联</h1><p>内容服务正在重新校准。浏览器不会自动刷新；请稍后手动重试，或先返回入口。</p><nav aria-label="故障恢复入口"><form method="get"><button type="submit">重试当前路径</button></form><a href="/">返回首页</a><a href="/articles">文章入口</a></nav></main></body></html>
HTML 503
	}
}

{$HAOBLOG_DOMAIN} {
	encode gzip
	vars haoblog_trace_id {http.request.uuid}
	@valid_trace header_regexp trace X-Request-ID ^[A-Za-z0-9._-]{1,64}$
	vars @valid_trace haoblog_trace_id {header.X-Request-ID}
	map {path} {haoblog_route_class} {
		~^/api/v1/admin/ admin_api
		~^/api/ api
		~^/(rss\.xml|sitemap\.xml)$ feed
		~^/articles/ article_content
		~^/studio studio
		~^/_nuxt/ static
		default public_page
	}
	log_append traceId {vars.haoblog_trace_id}
	log_append routeClass {haoblog_route_class}
	log_append errorCode {http.response.header.X-HaoBlog-Gateway-Error}
	log {
		output stdout
		format filter {
			request>uri delete
			request>headers delete
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
		}
	}

	handle /actuator {
		respond 404
	}
	handle /actuator/* {
		respond 404
	}

	@api path /rss.xml /sitemap.xml /api /api/*
	handle @api {
		reverse_proxy api:8080 {
			header_up X-Request-ID {vars.haoblog_trace_id}
			header_down X-Request-ID {vars.haoblog_trace_id}
			lb_retries 0
			transport http {
				dial_timeout 2s
				response_header_timeout 10s
				max_conns_per_host 64
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Request-ID {vars.haoblog_trace_id}
			header_down X-Request-ID {vars.haoblog_trace_id}
			@upstream_error status 500 502 503 504
			handle_response @upstream_error {
				header X-HaoBlog-Gateway-Error UPSTREAM_5XX
				import web_failure
			}
			lb_retries 0
			transport http {
				dial_timeout 2s
				response_header_timeout 10s
				max_conns_per_host 32
			}
		}
	}

	handle_errors {
		header X-Request-ID {vars.haoblog_trace_id}
		@api_error path /rss.xml /sitemap.xml /api /api/*
		handle @api_error {
			header Content-Type application/problem+json
			header Cache-Control no-store
			@api_timeout expression `{err.status_code} == 504 || {err.message}.contains("timeout") || {err.message}.contains("deadline exceeded")`
			handle @api_timeout {
				respond <<JSON
{"code":"GATEWAY_TIMEOUT","title":"Gateway timeout","detail":"The upstream service did not respond in time","traceId":"{vars.haoblog_trace_id}"}
JSON 504
			}
			header Retry-After 1
			respond <<JSON
{"code":"UPSTREAM_UNAVAILABLE","title":"Upstream unavailable","detail":"The upstream service is temporarily unavailable","traceId":"{vars.haoblog_trace_id}"}
JSON 503
		}

		@timeout expression `{err.status_code} == 504 || {err.message}.contains("timeout") || {err.message}.contains("deadline exceeded")`
		handle @timeout {
			header X-HaoBlog-Gateway-Error GATEWAY_TIMEOUT
			import web_failure
		}
		header X-HaoBlog-Gateway-Error UPSTREAM_UNAVAILABLE
		import web_failure
	}
}
