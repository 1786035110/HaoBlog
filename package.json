{
  "name": "haoblog",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "web:typecheck": "pnpm --dir apps/web typecheck",
    "web:test": "pnpm --dir apps/web test",
    "web:build": "pnpm --dir apps/web build",
    "web:e2e": "pnpm --dir apps/web e2e",
    "web:budget": "pnpm --dir apps/web check:article-budget",
    "web:lighthouse": "pnpm --dir apps/web lighthouse",
    "api-client:generate": "pnpm --filter @haoblog/api-client generate",
    "api-client:check": "pnpm --filter @haoblog/api-client check",
    "compose:verify": "node scripts/compose.mjs --env-file infra/compose/.env.ci.example -f infra/compose/compose.prod.yml config --format json | node scripts/verify-compose-resources.mjs -",
    "candidate": "node scripts/local-candidate.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "stage6": "node scripts/stage6-acceptance.mjs"
  }
}
